PORT=3000
NODE_ENV=development_ou_production
TRUST_PROXY_HOPS=0

MONGO_HOST=seu_host
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=usuario_root
MONGO_INITDB_ROOT_PASSWORD=senha_root
MONGO_INITDB_DATABASE=nome_do_banco
MONGO_AUTH_SOURCE=admin

SALT=salt_aleatorio_com_ao_menos_16_caracteres
JWT_SECRET=segredo_aleatorio_com_ao_menos_32_caracteres

ENCRYPTION_KEY=segredo_aleatorio_com_ao_menos_32_caracteres
SESSION_SECRET=segredo_aleatorio_com_ao_menos_32_caracteres

CORS_ALLOWED_ORIGINS=seu_frontend_url (ex: http://localhost:8080)
CORS_ALLOW_NO_ORIGIN=true ou false (dependendo se deseja permitir requisições sem origem)
